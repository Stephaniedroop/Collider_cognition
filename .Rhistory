source(here('Scripts', 'optimUtils4par.R'))
# WARNING: plotUtils.r line 6 assigns a character vector to `models`, and
# optimUtils4par.R line 14 assigns a list of model specifications to the same
# name. Whichever file you source second wins. get_optimisation() and
# get_prediction() both index models[[mname]], so source plotUtils.r LAST only
# after you have finished calling them, or rename one of the two objects.
models_spec <- models # keep a copy of the list before it can be clobbered
source(here('Scripts', 'plotUtils.r'))
load(here('Data', 'modelData', 'goOptim.rda')) # loads mp and df
# ---------------------------------------------------------------
# 1. Predictions at parameters you choose
# ---------------------------------------------------------------
make_pars <- function(tau1, epsilon, tau2, kappa) {
c(log(tau1), qlogis(epsilon), log(tau2), log(kappa))
}
pars_fixed <- make_pars(tau1 = 1, epsilon = 0.1, tau2 = 1, kappa = 0.5)
pred_colname <- "noSelect_tau1_1" # the string you will pass to the plot function
preds <- get_prediction(
pars = pars_fixed,
mp = mp,
df = df,
model = noSelect
)
# ---------------------------------------------------------------
# 2. Merge onto df, exactly as 05optimise.R does
# ---------------------------------------------------------------
# df already holds pgroup, prop, SE, Observed, Actual and
# trial_structure_type, so the merge supplies every variable the plotting
# function reads. Rename predicted_prob to the model column name first.
load(here('Data', 'modelData', 'fitforplot4par.rda')) # loads fitforplot
preds_wide <- preds |>
select(trial_id, node3, predicted_prob) |>
rename(!!pred_colname := predicted_prob)
# split() names its elements with as.character(trial_id), so coerce the key on
# both sides rather than relying on merge() to reconcile the two types.
preds_wide$trial_id <- as.character(preds_wide$trial_id)
df_key <- df
df_key$trial_id <- as.character(df_key$trial_id)
fitfixed <- merge(preds_wide, df_key, by = c("trial_id", "node3"))
# Fail loudly if the merge dropped rows or df lacks a plotting variable.
stopifnot(nrow(fitfixed) == nrow(df))
needed <- c(
"pgroup",
"prop",
"SE",
"Observed",
"Actual",
"trial_structure_type",
pred_colname
)
missing <- setdiff(needed, names(fitfixed))
if (length(missing) > 0) {
stop("fitfixed is missing: ", paste(missing, collapse = ", "))
}
# ---------------------------------------------------------------
# 3. Fix the Actual column type
# ---------------------------------------------------------------
# prepare_trials() multiplies newdf$pred by newdf$Actual, which requires Actual
# to be numeric. plot_model_pgroup() maps Actual to colour and then applies
# scale_colour_manual(values = c('gray', 'black')), which requires a discrete
# variable. Those two demands conflict, so convert to a factor after the
# prediction step and before plotting.
class(df$Actual) # inspect before deciding
fitfixed$Actual <- factor(fitfixed$Actual)
# ---------------------------------------------------------------
# 4. Plot, one panel set per pgroup
# ---------------------------------------------------------------
pgroups <- unique(fitfixed$pgroup)
pgroups
p <- plot_model_pgroup(
model_colname = pred_colname,
pgroup_label = pgroups[2],
df = fitfixed
)
print(p)
p
ggsave(
filename = 'ns2notau.pdf',
plot = p,
path = here("Other", "Plots"),
width = 12,
height = 6,
units = "in"
)
