units = "in"
)
# Best fitting model for other pgroups:
plotna2 <- plot_model_pgroup('noAct', 'A=.5,Au=.1,B=.5,Bu=.8', df)
print(plotna2)
ggsave(
filename = "noAct2.pdf",
plot = plotna2,
path = here("Other", "Plots"),
width = 12,
height = 6,
units = "in"
)
plotna1 <- plot_model_pgroup('noAct', 'A=.1,Au=.5,B=.8,Bu=.5', df)
print(plotna1)
ggsave(
filename = "noAct1.pdf",
plot = plotna1,
path = here("Other", "Plots"),
width = 12,
height = 6,
units = "in"
)
View(df)
